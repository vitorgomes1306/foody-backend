generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// TENANT (Food Truck)
// ─────────────────────────────────────────
model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  logoUrl     String?
  phone       String?
  deliveryFee Decimal  @default(0) @db.Decimal(10, 2)
  settings    Json?
  ownerId     Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  zipCode     String?
  street      String?
  number      String?
  complement  String?
  district    String?
  city        String?
  state       String?
  country     String?
  email       String?
  website     String?
  instagram   String?
  facebook    String?
  twitter     String?
  youtube     String?
  geoLocation String?

  // Relacionamentos
  owner                      User                        @relation(fields: [ownerId], references: [id])
  media                      TenantMedia[]
  openingHours               TenantOpeningHour[]
  paymentMethods             TenantPaymentMethod[]
  deliveryDrivers            DeliveryDriver[]
  deliveryMen                deliveryMen[]
  waiters                    Waiter[]
  categories                 Category[]
  products                   Product[]
  orders                     Order[]
  tables                     Table[]
  whatsAppChannels           WhatsAppChannel[]
  whatsAppWebhookEvents      WhatsAppWebhookEvent[]
  whatsAppConversationStates WhatsAppConversationState[]
  printJobs                  PrintJob[]
  printerStations            PrinterStation[]
}

enum WhatsAppProvider {
  official
  evolution
}

model WhatsAppChannel {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @db.Uuid
  provider              WhatsAppProvider
  active                Boolean          @default(false)
  status                String           @default("disconnected")
  wabaId                String?
  phoneNumberId         String?
  accessTokenEncrypted  String?
  appSecretEncrypted    String?
  evolutionInstanceName String?
  evolutionInstanceId   String?
  connectedNumber       String?
  selectedForMessaging  Boolean          @default(false)
  messagingStartedAt    DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([tenantId, selectedForMessaging])
}

model WhatsAppWebhookEvent {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  provider    WhatsAppProvider
  eventType   String
  externalId  String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, provider, createdAt])
  @@index([externalId])
}

model WhatsAppConversationState {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  provider   WhatsAppProvider
  contactJid String
  archivedAt DateTime?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, contactJid])
  @@index([tenantId, provider, archivedAt])
}

model TenantOpeningHour {
  id        Int      @id @default(autoincrement())
  tenantId  String   @db.Uuid
  weekday   Weekday
  closed    Boolean  @default(false)
  openTime  String?
  closeTime String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekday])
  @@index([tenantId])
}

model TenantPaymentMethod {
  id        Int               @id @default(autoincrement())
  tenantId  String            @db.Uuid
  type      PaymentMethodType
  enabled   Boolean           @default(true)
  label     String?
  details   Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

model DeliveryDriver {
  id        Int      @id @default(autoincrement())
  tenantId  String   @db.Uuid
  name      String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantMedia {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  kind      String
  url       String
  mimeType  String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model MediaLibraryImage {
  id           String   @id @default(uuid()) @db.Uuid
  url          String
  path         String
  bucket       String
  mimeType     String?
  sizeBytes    Int?
  title        String?
  description  String?
  category     String?
  keywords     String[] @default([])
  uploadedById Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// USUÁRIO
// ─────────────────────────────────────────
model User {
  id                    Int      @id @default(autoincrement())
  name                  String
  email                 String   @unique
  password              String
  role                  Role     @default(user)
  plan                  Plan     @default(master)
  active                Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  billingCustomerId     String?  @unique
  billingTrialStartedAt DateTime @default(now())
  liteSessionId         String?
  billingPlanChangeRequired Boolean @default(false)

  tenants            Tenant[]
  orders             Order[]
  mediaLibraryImages MediaLibraryImage[]
  subscriptions      Subscription[]
  pushDeviceTokens   PushDeviceToken[]

  // Usuario administrador do sistema (não relacionado a nenhum tenant)
  isAdmin Boolean @default(false)
}

// Configuração global de cobrança. Existe uma única linha (id = 1).
model BillingSettings {
  id                      Int      @id @default(1)
  activeProvider          String   @default("sicoob")
  litePrice               Decimal  @default(29.90) @db.Decimal(10, 2)
  basicPrice              Decimal  @default(99.90) @db.Decimal(10, 2)
  masterPrice             Decimal  @default(199.90) @db.Decimal(10, 2)
  initialTrialDays        Int      @default(7)
  postExpirationGraceDays Int      @default(3)
  subscriptionDays        Int      @default(30)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Subscription {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             Int
  plan               Plan
  provider           String
  status             String    @default("pending")
  amount             Decimal   @db.Decimal(10, 2)
  currency           String    @default("brl")
  providerCheckoutId String?   @unique
  providerPaymentId  String?   @unique
  paymentMethod      String?
  startsAt           DateTime?
  endsAt             DateTime?
  graceEndsAt        DateTime?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, endsAt])
  @@index([provider, providerCheckoutId])
}

model PushDeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     Int
  token      String   @unique
  platform   String   @default("android")
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model AppNotice {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  message       String
  show          Boolean   @default(false)
  audience      String    @default("all")
  startsAt      DateTime?
  endsAt        DateTime?
  lastPushAt    DateTime?
  lastPushCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([show, startsAt, endsAt])
}

// ─────────────────────────────────────────
// CATEGORIA DO CARDÁPIO
// ─────────────────────────────────────────
model Category {
  id               Int      @id @default(autoincrement())
  name             String
  iconKey          String?
  tenantId         String   @db.Uuid
  active           Boolean  @default(true)
  printerStationId Int?
  createdAt        DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printerStation PrinterStation? @relation(fields: [printerStationId], references: [id], onDelete: SetNull)
  products       Product[]
}

// ─────────────────────────────────────────
// ESTAÇÃO DE IMPRESSÃO (roteamento de comandas por impressora)
// ─────────────────────────────────────────
model PrinterStation {
  id        Int      @id @default(autoincrement())
  tenantId  String   @db.Uuid
  key       String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories Category[]

  @@unique([tenantId, key])
}

// ─────────────────────────────────────────
// PRODUTO
// ─────────────────────────────────────────
model Product {
  id             Int      @id @default(autoincrement())
  seq            Int
  name           String
  description    String?
  barcode        String?
  price          Decimal  @db.Decimal(10, 2)
  imageUrl       String?
  active         Boolean  @default(true)
  allowFraction  Boolean  @default(false)
  skipKds        Boolean  @default(false)
  featuredOnMenu Boolean  @default(false)
  menuSchedule   Json?
  usesFlavors    Boolean  @default(false)
  maxFlavors     Int      @default(1)
  tenantId       String   @db.Uuid
  categoryId     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  category           Category         @relation(fields: [categoryId], references: [id])
  orderItems         OrderItem[]      @relation("OrderItemProduct")
  fractionOrderItems OrderItem[]      @relation("OrderItemFractionProduct")
  optionGroups       OptionGroup[]
  flavors            ProductFlavor[]
  variants           ProductVariant[]

  @@unique([tenantId, seq])
}

model ProductFlavor {
  id          Int      @id @default(autoincrement())
  productId   Int
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItemFlavor[]
  variantPrices ProductVariantFlavor[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  price     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  seq       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  flavorPrices ProductVariantFlavor[]
  orderItems   OrderItem[]

  @@unique([productId, name])
  @@index([productId, seq])
}

model ProductVariantFlavor {
  id        Int     @id @default(autoincrement())
  variantId Int
  flavorId  Int
  price     Decimal @db.Decimal(10, 2)
  active    Boolean @default(true)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  flavor  ProductFlavor  @relation(fields: [flavorId], references: [id], onDelete: Cascade)

  @@unique([variantId, flavorId])
  @@index([flavorId])
}

// ─────────────────────────────────────────
// GRUPO DE OPÇÕES (ex: "Ponto da Carne", "Tamanho", "Borda")
// ─────────────────────────────────────────
model OptionGroup {
  id        Int     @id @default(autoincrement())
  name      String
  required  Boolean @default(false)
  multiple  Boolean @default(false)
  min       Int     @default(0)
  max       Int     @default(1)
  productId Int

  product Product  @relation(fields: [productId], references: [id])
  options Option[]
}

// ─────────────────────────────────────────
// OPÇÃO (ex: "Bem passado", "Bacon +R$3", "Borda Recheada")
// ─────────────────────────────────────────
model Option {
  id            Int     @id @default(autoincrement())
  name          String
  priceModifier Decimal @default(0) @db.Decimal(10, 2)
  groupId       Int

  group            OptionGroup       @relation(fields: [groupId], references: [id])
  orderItemOptions OrderItemOption[]
}

// ─────────────────────────────────────────
// MESA (pedidos presenciais)
// ─────────────────────────────────────────
model Table {
  id       Int    @id @default(autoincrement())
  number   Int
  capacity Int    @default(4)
  tenantId String @db.Uuid

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  orders Order[]

  @@unique([tenantId, number])
}

// ─────────────────────────────────────────
// PEDIDO
// ─────────────────────────────────────────
model Order {
  id                            Int                @id @default(autoincrement())
  tenantId                      String             @db.Uuid
  userId                        Int?
  tableId                       Int?
  type                          OrderType
  status                        OrderStatus        @default(pending)
  statusChangedAt               DateTime           @default(now())
  total                         Decimal            @db.Decimal(10, 2)
  deliveryFee                   Decimal            @default(0) @db.Decimal(10, 2)
  cancellationFee               Decimal            @default(0) @db.Decimal(10, 2)
  cancellationPaymentMethodType PaymentMethodType?
  cancellationFeePaidAt         DateTime?
  deliveryManId                 Int?
  deliveryCancelledAt           DateTime?
  waiterId                      Int?
  paymentMethodType             PaymentMethodType?
  paidAt                        DateTime?
  discountAmount                Decimal            @default(0) @db.Decimal(10, 2)
  waiterCommissionPercent       Decimal            @default(0) @db.Decimal(5, 2)
  waiterCommissionAmount        Decimal            @default(0) @db.Decimal(10, 2)
  waiterCommissionAddedToTotal  Boolean            @default(false)
  notes                         String?
  customerName                  String?
  customerPhone                 String?
  customerAddress               String?
  customerSessionId             String?
  dailyNumber                   Int?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  table       Table?       @relation(fields: [tableId], references: [id])
  deliveryMan deliveryMen? @relation(fields: [deliveryManId], references: [id])
  waiter      Waiter?      @relation(fields: [waiterId], references: [id])
  items       OrderItem[]
  extras      OrderExtra[]
  printJobs   PrintJob[]

  @@index([tenantId, customerSessionId, createdAt])
}

// Contador auxiliar para gerar o número diário do pedido (reinicia a cada dia por tenant)
model OrderDailyCounter {
  tenantId   String   @db.Uuid
  date       DateTime @db.Date
  lastNumber Int      @default(0)

  @@id([tenantId, date])
}

model OrderExtra {
  id          Int      @id @default(autoincrement())
  orderId     Int
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PrintJob {
  id          Int       @id @default(autoincrement())
  tenantId    String    @db.Uuid
  orderId     Int
  type        String    @default("customer_bill")
  status      String    @default("pending")
  requestedBy String?
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  printedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([orderId])
}

model Waiter {
  id        Int      @id @default(autoincrement())
  tenantId  String   @db.Uuid
  name      String
  username  String
  password  String
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, username])
  @@index([tenantId])
}

// ─────────────────────────────────────────
// ITEM DO PEDIDO
// ─────────────────────────────────────────
model OrderItem {
  id                 Int          @id @default(autoincrement())
  orderId            Int
  productId          Int
  fractionProductId  Int?
  variantId          Int?
  variantNameApplied String?
  quantity           Int
  unitPrice          Decimal      @db.Decimal(10, 2)
  notes              String?
  kitchenStatus      OrderStatus?
  addedAt            DateTime?

  order           Order             @relation(fields: [orderId], references: [id])
  product         Product           @relation("OrderItemProduct", fields: [productId], references: [id])
  fractionProduct Product?          @relation("OrderItemFractionProduct", fields: [fractionProductId], references: [id])
  variant         ProductVariant?   @relation(fields: [variantId], references: [id])
  options         OrderItemOption[]
  flavors         OrderItemFlavor[]

  @@index([fractionProductId])
  @@index([variantId])
}

model OrderItemFlavor {
  id           Int     @id @default(autoincrement())
  orderItemId  Int
  flavorId     Int
  nameApplied  String
  priceApplied Decimal @db.Decimal(10, 2)
  fraction     Decimal @db.Decimal(5, 4)

  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  flavor    ProductFlavor @relation(fields: [flavorId], references: [id])

  @@index([orderItemId])
  @@index([flavorId])
}

// ─────────────────────────────────────────
// OPÇÕES ESCOLHIDAS NO ITEM
// ─────────────────────────────────────────
model OrderItemOption {
  id          Int     @id @default(autoincrement())
  orderItemId Int
  optionId    Int
  quantity    Int     @default(1)
  priceAdded  Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  option    Option    @relation(fields: [optionId], references: [id])
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────
enum Role {
  user
  admin
  tenant
}

enum Plan {
  lite
  basic
  master
}

enum OrderType {
  local // consumir no local
  delivery // entrega
  takeaway // feito no balcão para levar
  pickup // retirada no local
}

enum OrderStatus {
  pending // pendente
  confirmed // confirmado
  preparing // preparando
  ready // pronto
  out_for_delivery // em entrega
  delivered // entregue
  cancelled // cancelado  // entreg
  returned //  devolvido
}

enum Weekday {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

enum PaymentMethodType {
  cash
  pix
  debit_card
  credit_card
  voucher
  other
}

// ─────────────────────────────────────────
// ENTREGADORES
// ─────────────────────────────────────────
model deliveryMen {
  id           Int          @id @default(autoincrement())
  name         String
  phone        String
  email        String?
  address      String
  plateVehicle String // placa do veiculo
  modelvehicle String // modelo do veiculo
  typeVehicle  TypeVehicle?
  avatar       String?
  // relação com o Tenant
  tenantId     String       @db.Uuid
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([tenantId])
}

enum TypeVehicle {
  Moto
  Carro
}
