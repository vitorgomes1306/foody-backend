# Stripe (somente no backend; nunca exponha estas chaves no Vite/frontend)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# URL pública do frontend usada pelos provedores de pagamento
APP_URL=https://chefitoonline.vercel.app
API_PUBLIC_URL=https://seu-backend.up.railway.app

# Sicoob Pix (provedor ativo)
SICOOB_CLIENT_ID=
SICOOB_CLIENT_SECRET=
SICOOB_PIX_KEY=
# Certificado PFX convertido integralmente para Base64
SICOOB_CERTIFICATE_BASE64=
SICOOB_CERTIFICATE_PASSWORD=
# Alternativa ao PFX: certificado PEM e chave privada, ambos em Base64
SICOOB_CERT_PEM_BASE64=
SICOOB_PRIVATE_KEY_BASE64=
# Opcionais — os valores abaixo já são os padrões do sistema
SICOOB_TOKEN_URL=https://auth.sicoob.com.br/auth/realms/cooperado/protocol/openid-connect/token
SICOOB_PIX_API_URL=https://api.sicoob.com.br/pix/api/v2
SICOOB_SCOPES=cob.write cob.read pix.read webhook.write webhook.read
SICOOB_PIX_EXPIRATION_SECONDS=1800
